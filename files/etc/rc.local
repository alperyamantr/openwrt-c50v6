#!/bin/sh
# Put your custom commands here that should be executed once
# the system init finished.

# nfqws executable bit'ini zapret baÅŸlamadan Ã¶nce set et
chmod +x /opt/zapret/nfqws

# --- SQM / Rate Limit (Bufferbloat Ã–nleyici - 50M/8M Hat Ä°Ã§in) ---
tc qdisc del dev eth0 root 2>/dev/null
tc qdisc add dev eth0 root handle 1: htb default 11
tc class add dev eth0 parent 1: classid 1:11 htb rate 7200kbit ceil 7200kbit
tc qdisc add dev eth0 parent 1:11 handle 10: fq_codel limit 10240 flows 1024 quantum 1514

# Internet geldikten sonra listeyi arka planda gÃ¼ncelle
(
    for i in $(seq 1 12); do
        wget -qO- --timeout=5 http://1.1.1.1 >/dev/null 2>&1 && break
        sleep 5
    done
    /usr/bin/hagezi-guncelle
) &

exit 0
