#!/bin/sh /etc/rc.common
START=99
STOP=10
USE_PROCD=1

FLOWOFFLOAD="software"
QUIC_MODE="desync"
WAN_IF="eth0.2"
LAN_IF="br-lan"
QUEUE_PKTS=4
NFQWS_BIN="/opt/zapret/nfqws"
FAKE_DIR="/opt/zapret/files/fake"

start_service() {
    stop_service > /dev/null 2>&1
    modprobe -q nfnetlink_queue 2>/dev/null

    sysctl -w net.netfilter.nf_conntrack_max=4096 >/dev/null 2>&1 || true
    sysctl -w net.netfilter.nfnetlink_queue_maxlen=1024 >/dev/null 2>&1 || true
    sysctl -w net.core.netdev_max_backlog=1024 >/dev/null 2>&1 || true
    sysctl -w net.netfilter.nf_conntrack_udp_timeout_stream=45 >/dev/null 2>&1 || true

    local NFQWS_ARGS="--qnum=80 --user=daemon --bind-fix4 \
    --filter-tcp=443 \
    --dpi-desync=fake,split \
    --dpi-desync-split-pos=1 \
    --dpi-desync-ttl=3 \
    --dpi-desync-repeats=1 \
    --dpi-desync-fooling=badsum \
    --dpi-desync-fake-tls=$FAKE_DIR/tls_clienthello_www_google_com.bin \
    --dpi-desync-cutoff=d3 \
    \
    --new \
    --filter-tcp=80 \
    --dpi-desync=fake,split \
    --dpi-desync-split-pos=method+2 \
    --dpi-desync-ttl=4 \
    --dpi-desync-repeats=1 \
    --dpi-desync-fooling=badsum \
    \
    --new \
    --filter-udp=19294-19344,50000-60000 \
    --dpi-desync=fake \
    --dpi-desync-ttl=4 \
    --dpi-desync-repeats=1 \
    --dpi-desync-any-protocol \
    --dpi-desync-cutoff=n2 \
    --dpi-desync-fake-unknown-udp=$FAKE_DIR/discord-ip-discovery-with-port.bin \
    \
    --new \
    --filter-udp=3478,3479,3480 \
    --dpi-desync=fake \
    --dpi-desync-ttl=4 \
    --dpi-desync-repeats=1 \
    --dpi-desync-any-protocol \
    --dpi-desync-cutoff=n2 \
    --dpi-desync-fake-unknown-udp=$FAKE_DIR/stun.bin"

    if [ "$QUIC_MODE" = "desync" ]; then
        NFQWS_ARGS="$NFQWS_ARGS \
        --new \
        --filter-udp=443 \
        --dpi-desync=fake \
        --dpi-desync-ttl=3 \
        --dpi-desync-repeats=1 \
        --dpi-desync-any-protocol \
        --dpi-desync-cutoff=n2 \
        --dpi-desync-fake-quic=$FAKE_DIR/quic_initial_www_google_com.bin"
    fi

    procd_open_instance
    procd_set_param command $NFQWS_BIN $NFQWS_ARGS
    procd_set_param respawn 60 10 5
    procd_set_param oom_score_adj -500
    procd_close_instance

    nft add table inet zapret 2>/dev/null || true
    nft add chain inet zapret forward '{ type filter hook forward priority -150; policy accept; }' 2>/dev/null || true

    nft add set inet zapret udp_ports '{ type inet_service; flags interval; }' 2>/dev/null || true
    nft add element inet zapret udp_ports '{ 19294-19344, 50000-60000, 3478-3480 }' 2>/dev/null || true

    local BYPASS_IPS="/etc/zapret-bypass-ips.txt"
    if [ -f "$BYPASS_IPS" ]; then
        while IFS= read -r ip; do
            case "$ip" in
                ""|\#*) continue ;;
                *:*) nft add rule inet zapret forward ip6 daddr "$ip" accept 2>/dev/null ;;
                *) nft add rule inet zapret forward ip daddr "$ip" accept 2>/dev/null ;;
            esac
        done < "$BYPASS_IPS"
    fi

    nft add rule inet zapret forward oifname "$WAN_IF" ip protocol tcp tcp dport 443 ct original packets 1-$QUEUE_PKTS queue flags bypass to 80 2>/dev/null
    nft add rule inet zapret forward oifname "$WAN_IF" ip protocol tcp tcp dport 80 ct original packets 1-$QUEUE_PKTS queue flags bypass to 80 2>/dev/null
    nft add rule inet zapret forward oifname "$WAN_IF" ip protocol udp udp dport @udp_ports ct original packets 1-$QUEUE_PKTS queue flags bypass to 80 2>/dev/null

    if [ "$QUIC_MODE" = "desync" ]; then
        nft add rule inet zapret forward oifname "$WAN_IF" ip protocol udp udp dport 443 ct original packets 1-$QUEUE_PKTS queue flags bypass to 80 2>/dev/null
    fi

    if [ "$FLOWOFFLOAD" = "software" ]; then
        nft add flowtable inet zapret ft "{ hook ingress priority 0; devices = { $LAN_IF, $WAN_IF }; }" 2>/dev/null || true
        nft add rule inet zapret forward oifname "$WAN_IF" ip protocol tcp tcp dport 443 ct original packets ">$QUEUE_PKTS" flow add @ft 2>/dev/null
        nft add rule inet zapret forward oifname "$WAN_IF" ip protocol tcp tcp dport 80 ct original packets ">$QUEUE_PKTS" flow add @ft 2>/dev/null
        nft add rule inet zapret forward oifname "$WAN_IF" ip protocol udp udp dport @udp_ports ct original packets ">$QUEUE_PKTS" flow add @ft 2>/dev/null
    fi
}

stop_service() {
    local pid=$(pidof nfqws)
    if [ -n "$pid" ]; then
        kill "$pid" 2>/dev/null
        sleep 2
        kill -0 "$pid" 2>/dev/null && kill -9 "$pid" 2>/dev/null
    fi
    nft delete table inet zapret 2>/dev/null || true
}

service_triggers() {
    procd_add_reload_trigger "zapret"
}
