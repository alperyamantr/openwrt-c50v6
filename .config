# Target
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt76x8=y
CONFIG_TARGET_ramips_mt76x8_DEVICE_tplink_archer-c50-v6=y

# Base system
CONFIG_PACKAGE_fstools=y
CONFIG_PACKAGE_block-mount=y

# ZRAM
CONFIG_PACKAGE_zram-swap=y
CONFIG_PACKAGE_kmod-zram=y

# Zapret bağımlılıkları
CONFIG_PACKAGE_iptables-mod-nfqueue=y
CONFIG_PACKAGE_kmod-nfnetlink-queue=y
CONFIG_PACKAGE_libnetfilter-queue=y

# SQM / QoS / Traffic Control (MINIMAL - packages.txt ile uyumlu)
CONFIG_PACKAGE_tc-tiny=y
CONFIG_PACKAGE_kmod-sched-fq-codel=y
CONFIG_PACKAGE_kmod-sched-cake=y

# Temel araçlar
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_htop=y

# LUCI - sadece base, mod'lar packages.txt'te
CONFIG_PACKAGE_luci-base=y